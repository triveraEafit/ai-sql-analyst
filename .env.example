# Copy to .env and fill in before running `docker compose up`.
# .env is git-ignored; this .env.example is committed with placeholders only.

# PostgreSQL superuser password (used by the app role / read-write datasource).
POSTGRES_PASSWORD=

# Password for the read-only database role created by db/01-init.sh.
DB_RO_PASSWORD=

# LLM provider: "mock" needs no API key; "http" uses the OpenAI-compatible settings below.
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=