# Copy to .env and run `docker compose up`. The demo passwords below work as is for LOCAL use
# only - change them for any shared or public deployment. LLM_API_KEY must NEVER be committed.
# .env is git-ignored; this .env.example is committed with placeholders/demo defaults only.

# PostgreSQL superuser password (used by the app role / read-write datasource).
POSTGRES_PASSWORD=demo_superpw

# Password for the read-only database role created by db/01-init.sh.
DB_RO_PASSWORD=ro_demo_pw

# LLM provider: "mock" needs no API key; "http" uses the OpenAI-compatible settings below.
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=